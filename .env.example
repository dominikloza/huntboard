# Copy to .env.local and fill in. Never commit real values.

# Day 1: database (Neon Postgres, region eu-central-1)
# Pooled connection (host contains -pooler): used by the app.
DATABASE_URL=
# Direct connection (no -pooler): used by drizzle-kit migrations.
DATABASE_URL_UNPOOLED=

# Day 1: auth (Better Auth)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# GitHub OAuth App, callback: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Day 5: AI provider (server-only, never NEXT_PUBLIC_)
# openai (default), google (Gemini) or mock (scripted demo model, no key needed;
# e2e tests always use mock)
AI_PROVIDER=openai
# platform.openai.com -> API keys (needs prepaid credit in Billing)
OPENAI_API_KEY=
# aistudio.google.com -> Get API key (has a free tier)
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: defaults to gpt-4.1-mini (openai) or gemini-3.5-flash-lite (google)
AI_MODEL=

# Day 6: rate limiting (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
