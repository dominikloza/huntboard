# Copy to .env.local and fill in. Never commit real values.

# Day 1: database (Neon Postgres, region eu-central-1)
# Pooled connection (host contains -pooler): used by the app.
# Tip: use sslmode=verify-full instead of sslmode=require to silence the pg SSL warning.
DATABASE_URL=
# Direct connection (no -pooler): used by drizzle-kit migrations.
DATABASE_URL_UNPOOLED=

# Day 1: auth (Better Auth)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# GitHub OAuth App, callback: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Day 5: AI provider (server-only, never NEXT_PUBLIC_)
OPENAI_API_KEY=

# Day 6: rate limiting (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
